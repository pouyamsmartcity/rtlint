{
  "name": "rtlint",
  "version": "0.3.0",
  "description": "rtlint by Pouyam: find and fix right-to-left (RTL) layout bugs and Persian typography in CSS, Tailwind, React, React Native, Vue, Svelte, HTML and text. Zero dependencies, safe --fix, ESLint/Stylelint/Vite plugins and an MCP server for AI assistants.",
  "keywords": [
    "arabic",
    "arabic-typography",
    "bidi",
    "bootstrap",
    "css",
    "eslint-plugin",
    "eslintplugin",
    "farsi",
    "half-space",
    "hebrew",
    "i18n",
    "i18n-linter",
    "l10n",
    "lint",
    "linter",
    "logical-properties",
    "mcp",
    "mcp-server",
    "persian",
    "persian-typography",
    "pouyam",
    "pre-commit",
    "react-native",
    "right-to-left",
    "rtl",
    "rtl-support",
    "sarif",
    "stylelint-plugin",
    "tailwind",
    "tailwind-rtl",
    "trojan-source",
    "typography",
    "urdu",
    "vite-plugin",
    "zwnj"
  ],
  "homepage": "https://github.com/pouyamsmartcity/rtlint#readme",
  "bugs": "https://github.com/pouyamsmartcity/rtlint/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pouyamsmartcity/rtlint.git"
  },
  "license": "MIT",
  "author": "Pouyam (https://www.pouyam.com)",
  "type": "module",
  "bin": {
    "rtlint": "bin/rtlint.js",
    "rtlint-mcp": "bin/rtlint-mcp.js"
  },
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./core": {
      "types": "./types/core.d.ts",
      "default": "./src/core.js"
    },
    "./eslint": {
      "types": "./types/eslint.d.ts",
      "default": "./src/eslint.js"
    },
    "./stylelint": {
      "types": "./types/stylelint.d.ts",
      "default": "./src/stylelint.js"
    },
    "./schema.json": "./schema/config.json",
    "./package.json": "./package.json",
    "./mcp": {
      "types": "./types/mcp.d.ts",
      "default": "./src/mcp.js"
    },
    "./vite": {
      "types": "./types/vite.d.ts",
      "default": "./src/vite.js"
    }
  },
  "files": [
    "bin",
    "src",
    "types",
    "schema",
    "README.md",
    "README.fa.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/rules.md",
    "docs/rules.fa.md",
    "llms.txt",
    "templates",
    "docs/ai.md",
    "docs/guides"
  ],
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc -p test/types",
    "schema": "node scripts/build-schema.js",
    "lint:self": "node bin/rtlint.js README.md README.fa.md docs llms.txt src bin --lang fa"
  },
  "peerDependencies": {
    "eslint": ">=9",
    "stylelint": ">=16"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    },
    "stylelint": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "stylelint": "^17.16.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  }
}
